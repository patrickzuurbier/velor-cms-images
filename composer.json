{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "patrickzuurbier/velor-cms-images",
    "description": "Image management and selection plugin for Velor CMS.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "velor/cms": "^1.17"
    },
    "autoload": {
        "psr-4": {
            "Velor\\Images\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Velor\\Images\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Velor\\Images\\Providers\\ImagesServiceProvider"
            ],
            "vite": [
                "resources/sass/cms.scss",
                "resources/js/cms.ts"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
